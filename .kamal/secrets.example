# Copy to .kamal/secrets (ignored by Git) and provide the registry/database values.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
POSTHOG_PROJECT_KEY=$POSTHOG_PROJECT_KEY
RAILS_MASTER_KEY=$(cat config/credentials/production.key)
FISCALIZA_DEPUTADOS_DATABASE_PASSWORD=$FISCALIZA_DEPUTADOS_DATABASE_PASSWORD
