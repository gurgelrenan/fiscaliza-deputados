<% content_for :title, "Despesas parlamentares do Ceará — Fiscaliza Deputados" %>

<section class="deputies-page" aria-labelledby="page-title">
  <div class="page-intro">
    <div>
      <h1 id="page-title">Despesas dos deputados</h1>
      <p>Consulte os registros parlamentares e abra os comprovantes disponíveis.</p>
    </div>
    <p class="page-intro__count"><strong><%= @deputies.length %></strong> parlamentares</p>
  </div>

  <% if @deputies.any? %>
    <div class="deputy-table-wrap">
      <table class="deputy-table">
        <thead>
          <tr>
            <th scope="col" class="deputy-table__person-heading">Parlamentar</th>
            <th scope="col" class="deputy-table__party-heading">Partido</th>
            <th scope="col" class="deputy-table__amount-heading">Total registrado</th>
            <th scope="col" class="deputy-table__action-heading"><span class="visually-hidden">Detalhes</span></th>
          </tr>
        </thead>
        <tbody>
          <% @deputies.each do |deputy| %>
            <tr>
              <td class="deputy-table__person" data-label="Parlamentar">
                <%= image_tag deputy.photo_url, class: "deputy-photo", alt: "Retrato de #{deputy.name}", loading: "lazy" %>
                <span class="deputy-name"><%= deputy.name %></span>
              </td>
              <td class="deputy-table__party" data-label="Partido"><%= deputy.political_party.presence || "Não informado" %></td>
              <td class="deputy-table__amount" data-label="Total registrado"><%= number_to_currency(deputy.total_expenses, unit: "R$ ", separator: ",", delimiter: ".") %></td>
              <td class="deputy-table__action" data-label="Detalhes"><%= link_to "Ver despesas", deputy_path(deputy), class: "text-link" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <h2>Nenhum registro encontrado</h2>
      <p>Não há despesas parlamentares disponíveis para exibir no momento.</p>
    </div>
  <% end %>
</section>
