<% content_for :title, "Despesas parlamentares do Ceará — Fiscaliza Deputados" %>

<section class="deputies-page" aria-labelledby="page-title" data-analytics-page="deputies_list"
         data-analytics-properties="<%= { search_active: @query.present?, result_count: @deputies.length }.to_json %>">
  <div class="home-intro">
    <div class="home-intro__message">
      <h1 id="page-title">O dinheiro é público.<br><span>Acompanhar é seu direito.</span></h1>
      <p>Conheça as despesas dos deputados federais do Ceará. Consulte os valores registrados e veja os comprovantes disponíveis.</p>
      <a href="#parlamentares" class="home-intro__action">Explorar despesas <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6"/></svg></a>
    </div>
    <aside class="home-guide" aria-labelledby="guide-title">
      <h2 id="guide-title">Do total ao comprovante.</h2>
      <p>Escolha um parlamentar para consultar as despesas por mês, os fornecedores e os documentos disponíveis.</p>
      <a href="https://dadosabertos.camara.leg.br/" target="_blank" rel="noopener">Fonte: Câmara dos Deputados</a>
    </aside>
  </div>

  <div class="home-list-heading" id="parlamentares">
    <div>
      <h2>Despesas dos deputados</h2>
      <p>Valores registrados na base. Selecione um nome para explorar.</p>
    </div>
    <p class="page-intro__count"><strong><%= @deputies.length %></strong> <%= @deputies.length == 1 ? "parlamentar" : "parlamentares" %></p>
  </div>

  <%= form_with url: deputies_path(anchor: "parlamentares"), method: :get, role: "search", class: "deputy-search", data: analytics_feature("search_deputies") do |form| %>
    <div class="deputy-search__field">
      <%= form.label :q, "Buscar por nome ou partido" %>
      <%= form.search_field :q, value: @query, placeholder: "Digite um nome ou a sigla do partido", maxlength: 200, class: "deputy-search__input" %>
    </div>
    <%= form.submit "Buscar", class: "expense-filter__submit", data: { turbo_submits_with: "Buscando…" } %>
    <% if @query.present? %>
      <%= link_to "Limpar busca", deputies_path(anchor: "parlamentares"), class: "expense-filter__clear", data: analytics_feature("clear_search") %>
    <% end %>
  <% end %>

  <% if @query.present? %>
    <p class="deputy-search__summary" role="status"><%= @deputies.length %> <%= @deputies.length == 1 ? "resultado" : "resultados" %> para “<%= @query %>”.</p>
  <% end %>

  <% if @deputies.any? %>
    <div class="deputy-table-wrap">
      <table class="deputy-table">
        <thead>
          <tr>
            <th scope="col" class="deputy-table__person-heading">Parlamentar</th>
            <th scope="col" class="deputy-table__party-heading">Partido</th>
            <th scope="col" class="deputy-table__amount-heading">Total registrado</th>
            <th scope="col" class="deputy-table__action-heading"><span class="visually-hidden">Detalhes</span></th>
          </tr>
        </thead>
        <tbody>
          <% @deputies.each do |deputy| %>
            <tr>
              <td class="deputy-table__person" data-label="Parlamentar">
                <div class="deputy-identity">
                  <% if deputy.photo_url.present? %>
                    <%= image_tag deputy.photo_url, class: "deputy-photo", alt: "Retrato de #{deputy.name}", loading: "lazy", width: 54, height: 68 %>
                  <% else %>
                    <span class="deputy-photo deputy-photo--placeholder" aria-hidden="true"><%= deputy.name.to_s.first %></span>
                  <% end %>
                  <%= link_to deputy.name, deputy_path(deputy), class: "deputy-name", data: analytics_feature("select_deputy", deputy_analytics_properties(deputy)) %>
                </div>
              </td>
              <td class="deputy-table__party" data-label="Partido"><span class="deputy-party"><%= deputy.political_party.presence || "Não informado" %></span></td>
              <td class="deputy-table__amount" data-label="Total registrado"><%= number_to_currency(deputy.total_expenses, unit: "R$ ", separator: ",", delimiter: ".") %></td>
              <td class="deputy-table__action" data-label="Detalhes"><%= link_to "Ver despesas", deputy_path(deputy), class: "text-link", aria: { label: "Ver despesas de #{deputy.name}" }, data: analytics_feature("select_deputy", deputy_analytics_properties(deputy)) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <% if @query.present? %>
        <h3>Nenhum deputado encontrado</h3>
        <p>Tente outro nome ou sigla de partido, ou limpe a busca para ver todos os deputados.</p>
      <% else %>
        <h2>Nenhum registro encontrado</h2>
        <p>Não há despesas parlamentares disponíveis para exibir no momento.</p>
      <% end %>
    </div>
  <% end %>
</section>
