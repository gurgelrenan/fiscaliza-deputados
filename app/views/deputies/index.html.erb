<% content_for :title, "Despesas parlamentares do Ceará — Fiscaliza Deputados" %>

<section class="deputies-page" aria-labelledby="page-title">
  <div class="page-intro">
    <div>
      <h1 id="page-title">Despesas dos deputados</h1>
      <p>Consulte os registros parlamentares e abra os comprovantes disponíveis.</p>
    </div>
    <p class="page-intro__count"><strong><%= @deputies.length %></strong> parlamentares</p>
  </div>

  <% if @expense_count.positive? %>
    <section class="intelligence" aria-labelledby="intelligence-title">
      <div class="intelligence__heading">
        <div>
          <h2 id="intelligence-title">Panorama das despesas</h2>
          <p>Leitura dos valores líquidos registrados no conjunto de dados disponível.</p>
        </div>
        <p class="intelligence__scope"><%= number_with_delimiter(@expense_count, delimiter: ".") %> lançamentos</p>
      </div>

      <div class="intelligence__summary">
        <p><strong><%= number_to_currency(@total_expenses, unit: "R$ ", separator: ",", delimiter: ".") %></strong><span>total registrado</span></p>
        <% if (top_type = @type_expenses.first) %>
          <% type_share = @total_expenses.zero? ? 0 : top_type.last / @total_expenses * 100 %>
          <p><strong><%= number_to_percentage(type_share, precision: 1, separator: ",") %></strong><span>em <%= top_type.first %></span></p>
        <% end %>
        <% if (top_year = @yearly_expenses.max_by { |_year, amount| amount }) %>
          <p><strong><%= top_year.first %></strong><span>ano com maior valor: <%= number_to_currency(top_year.last, unit: "R$ ", separator: ",", delimiter: ".") %></span></p>
        <% end %>
      </div>

      <div class="intelligence__charts">
        <div class="intelligence-chart">
          <h3>Despesas por ano</h3>
          <% if @yearly_expenses.any? %>
            <% yearly_max = @yearly_expenses.values.map(&:to_f).max %>
            <div class="year-chart" role="img" aria-label="Gráfico de despesas por ano">
              <% @yearly_expenses.each do |year, amount| %>
                <% height = yearly_max.zero? ? 0 : amount.to_f / yearly_max * 100 %>
                <div class="year-chart__column" title="<%= year %>: <%= number_to_currency(amount, unit: "R$ ", separator: ",", delimiter: ".") %>">
                  <span class="year-chart__amount"><%= number_to_currency(amount, unit: "R$ ", separator: ",", delimiter: ".") %></span>
                  <span class="year-chart__bar" style="--bar-height: <%= height %>%"></span>
                  <span class="year-chart__label"><%= year %></span>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="muted-note">Os registros não informam o ano.</p>
          <% end %>
        </div>

        <div class="intelligence-chart">
          <h3>Maiores tipos de despesa</h3>
          <% type_max = @type_expenses.map { |_description, amount| amount.to_f }.max.to_f %>
          <ol class="type-chart">
            <% @type_expenses.each do |description, amount| %>
              <% width = type_max.zero? ? 0 : amount.to_f / type_max * 100 %>
              <li>
                <div class="type-chart__meta"><span><%= description.presence || "Tipo não informado" %></span><strong><%= number_to_currency(amount, unit: "R$ ", separator: ",", delimiter: ".") %></strong></div>
                <span class="type-chart__track"><span class="type-chart__bar" style="--bar-width: <%= width %>%"></span></span>
              </li>
            <% end %>
          </ol>
        </div>
      </div>

      <div class="intelligence__ranking">
        <h3>Maiores totais por parlamentar</h3>
        <ol>
          <% @top_spenders.each do |deputy| %>
            <li><%= link_to deputy.name, deputy_path(deputy) %><strong><%= number_to_currency(deputy.total_expenses, unit: "R$ ", separator: ",", delimiter: ".") %></strong></li>
          <% end %>
        </ol>
      </div>
      <p class="intelligence__note">Os valores refletem os lançamentos importados e não indicam, por si só, irregularidade. Consulte os registros e comprovantes para avaliar cada despesa.</p>
    </section>
  <% end %>

  <% if @deputies.any? %>
    <div class="deputy-table-wrap">
      <table class="deputy-table">
        <thead>
          <tr>
            <th scope="col" class="deputy-table__person-heading">Parlamentar</th>
            <th scope="col" class="deputy-table__party-heading">Partido</th>
            <th scope="col" class="deputy-table__amount-heading">Total registrado</th>
            <th scope="col" class="deputy-table__action-heading"><span class="visually-hidden">Detalhes</span></th>
          </tr>
        </thead>
        <tbody>
          <% @deputies.each do |deputy| %>
            <tr>
              <td class="deputy-table__person" data-label="Parlamentar">
                <%= image_tag deputy.photo_url, class: "deputy-photo", alt: "Retrato de #{deputy.name}", loading: "lazy" %>
                <span class="deputy-name"><%= deputy.name %></span>
              </td>
              <td class="deputy-table__party" data-label="Partido"><%= deputy.political_party.presence || "Não informado" %></td>
              <td class="deputy-table__amount" data-label="Total registrado"><%= number_to_currency(deputy.total_expenses, unit: "R$ ", separator: ",", delimiter: ".") %></td>
              <td class="deputy-table__action" data-label="Detalhes"><%= link_to "Ver despesas", deputy_path(deputy), class: "text-link" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <h2>Nenhum registro encontrado</h2>
      <p>Não há despesas parlamentares disponíveis para exibir no momento.</p>
    </div>
  <% end %>
</section>
